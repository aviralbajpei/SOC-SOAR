          "mode": "name",
          "value": "soc_cases"
        },
        "returnAll": false,
        "filters": {
          "conditions": [
            {
              "keyName": "case_id",
              "condition": "eq",
              "keyValue": "={{ $json.query.id }}"
            }
          ]
        },
        "limit": 1
