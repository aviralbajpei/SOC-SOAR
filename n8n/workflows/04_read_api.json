    {
      "parameters": {
        "jsCode": "const keep = ['case_id', 'created_at', 'updated_at', 'alert_id', 'status', 'route', 'priority', 'risk_score', 'classification', 'confidence', 'flags', 'model', 'exception_stage', 'total_latency_ms', 'retries', 'hallucinated_ids'];\nconst rows = $input.all().map((i) => i.json).filter((r) => r.case_id);\nreturn [{ json: { cases: rows.map((r) => Object.fromEntries(keep.map((k) => [k, r[k] ?? null]))) } }];"
      },
      "name": "Shape Cases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -240
      ],
      "id": "1e7280ff-1b23-4be2-8c5f-959ada104eda"
    },
    {
      "parameters": {
